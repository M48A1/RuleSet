# 拼多多广告 URL：HTTPS 匹配需要开启 MITM 并信任证书。
# 主配置 MITM hostname 需包含：video-dsp.pddpic.com, t-dsp.pinduoduo.com, images.pinduoduo.com
URL-REGEX,^https:\/\/video-dsp\.pddpic\.com\/market-dsp-video\/
URL-REGEX,^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_
URL-REGEX,^https:\/\/images\.pinduoduo\.com\/mrk\/
URL-REGEX,^https:\/\/images\.pinduoduo\.com\/marketing_api\/

# 拦截 HTTPDNS（Surge RULE-SET 转换）
# 原作者：VirgilClyne
# 来源：https://github.com/QingRex/LoonKissSurge/blob/main/Surge/Official/拦截HTTPDNS.official.sgmodule
# 转换日期：2026-10-29；移除逐条策略和 pre-matching，保留匹配范围。
# 以下模块设置不能写入规则集，仅作主配置参考；未自动修改主配置。
# HTTPS URL 规则需相应 MITM，HTTP URL 规则需流量经过 HTTP 引擎。
# [General] force-http-engine-hosts = %APPEND% 119.29.29.29:80, dns.weixin.qq.com:80, dns.weixin.qq.com:8080, dns.weixin.qq.com:443
# [MITM] hostname = %APPEND% 119.29.29.98, 119.29.29.99, amdc.alipay.com, amdc-sibling.alipay.com.cn, dns.jd.com, *.httpdns.pro

