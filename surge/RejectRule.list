# 拼多多广告 URL：HTTPS 匹配需要开启 MITM 并信任证书。
# 主配置 MITM hostname 需包含：video-dsp.pddpic.com, t-dsp.pinduoduo.com, images.pinduoduo.com
URL-REGEX,^https:\/\/video-dsp\.pddpic\.com\/market-dsp-video\/
URL-REGEX,^https:\/\/t-dsp\.pinduoduo\.com\/dspcb\/i\/mrk_
URL-REGEX,^https:\/\/images\.pinduoduo\.com\/mrk\/
URL-REGEX,^https:\/\/images\.pinduoduo\.com\/marketing_api\/
