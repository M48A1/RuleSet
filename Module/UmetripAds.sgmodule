#!name=航旅纵横净化[墨鱼版·Surge适配]
#!desc=原作者 @ddgksf2013；自动下载适配脚本；需开启 MITM、信任证书。

# 原配置：https://ddgksf2013.top/rewrite/UmetripAds.conf
# 原脚本：https://ddgksf2013.top/scripts/umetrip.ads.js
# Surge 适配：2026-10-29

[Rule]
URL-REGEX,^https:\/\/oss\.umetrip\.com\/fs\/advert\/,REJECT-TINYGIF

[Script]
UmetripAds = type=http-response, pattern=^https:\/\/(?:sns|appmsg|home|umehome|opactivity|activity|umerp|flightstatus|umeflightstatus|startup|umestartup|user|umeuser|event)\.umetrip\.com\/gateway\/api\/umetrip\/native(?:\?.*)?$, requires-body=true, binary-body-mode=true, max-size=1048576, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/umetrip.ads.surge.js

[MITM]
hostname = %APPEND% sns.umetrip.com, appmsg.umetrip.com, home.umetrip.com, umehome.umetrip.com, opactivity.umetrip.com, activity.umetrip.com, umerp.umetrip.com, flightstatus.umetrip.com, umeflightstatus.umetrip.com, startup.umetrip.com, umestartup.umetrip.com, user.umetrip.com, umeuser.umetrip.com, event.umetrip.com, oss.umetrip.com
