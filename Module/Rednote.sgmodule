#!name=RedNote Ad Block
#!desc=小红书去广告（信息流 / 搜索 / 开屏等）；需开启 MITM 并信任证书。
#!author=@ddgksf2013
#!moduleUrl=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Rednote.sgmodule
#!category= AntiAD
#!date=2026-11-01

# 安全调整（2026-11-01）：删除 /user/teenager/status 的空响应规则，避免影响青少年模式状态。
# 脚本已镜像到 Module/Scripts/ddgksf2013/redbook.ads.js。

[Map Local]
^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\/recommend_info\? data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/gslb data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/httpdns data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/(tag\/)?ads data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/v\d+\/stateReport data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/data\/native\/matrix_switches data-type=text data=" " status-code=200

^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/guide\/home_guide data-type=text data=" " status-code=200

[Script]
redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/tabfeed, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/video\/save, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/live_photo\/save, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/notes\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/widgets, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/redtube\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/videofeed\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/feed\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/note\/imagefeed, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/splash_config, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/system_service\/config\?, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/hot_list, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/hint, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/homefeed\/categories, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

redbook.ads = type=http-response, pattern=^https?:\/\/[a-z]+\.xiaohongshu\.com\/api\/sns\/v\d+\/search\/trending, script-path=https://raw.githubusercontent.com/M48A1/RuleSet/main/Module/Scripts/ddgksf2013/redbook.ads.js, requires-body=true, max-size=1048576, timeout=60

[MITM]
hostname = %APPEND% *.xiaohongshu.com
